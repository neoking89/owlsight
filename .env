# Model settings
MODEL_SETTINGS_MODEL_ID=your_model_id_here
MODEL_SETTINGS_TOKENIZER_ID=your_tokenizer_id_here
MODEL_SETTINGS_SAVE_HISTORY=false
MODEL_SETTINGS_SYSTEM_PROMPT=
MODEL_SETTINGS_QUANTIZATION_BITS=32

# Generation settings
GENERATION_SETTINGS_MAX_NEW_TOKENS=1024
GENERATION_SETTINGS_TEMPERATURE=0.0
GENERATION_SETTINGS_GENERATION_KWARGS_TOP_K=50
GENERATION_SETTINGS_GENERATION_KWARGS_TOP_P=0.9
GENERATION_SETTINGS_GENERATION_KWARGS_REPETITION_PENALTY=1.0

# Main settings
MAIN_SETTINGS_MAX_RETRIES_ON_ERROR=3
MAIN_SETTINGS_PROMPT_CODE_EXECUTION=true
